+function mirrorPs5RouteHistory(stack) {
+  if (!stack.length || typeof window.history?.pushState !== "function") {
+    return false;
+  }
+  try {
+    stack.forEach((entry, index) => {
+      const state = {
+        route: entry.route,
+        params: entry.params || {},
+        previousRoute: index > 0 ? stack[index - 1].route : null
+      };
+      if (index === 0) {
+        window.history.replaceState(state, "");
+      } else {
+        window.history.pushState(state, "");
+      }
+    });
