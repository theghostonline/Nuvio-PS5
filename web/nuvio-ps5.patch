       cp(path.join(rootDir, "docs", "youtube-proxy.html"), path.join(distDir, "youtube-proxy.html"))
     ]);
     await buildI18nBundles({ rootDir, distDir });
diff --git a/js/platform/adapters/ps5Adapter.js b/js/platform/adapters/ps5Adapter.js
new file mode 100644
index 0000000..d82ec1a
--- /dev/null
+++ b/js/platform/adapters/ps5Adapter.js
@@ -0,0 +1,62 @@
+import { isBackEvent, normalizeKeyEvent } from "../sharedKeys.js";
+import { Ps5Diagnostics } from "../ps5/ps5Diagnostics.js";
+import { Ps5Input } from "../ps5/ps5Input.js";
+
+// The PS5 browser reports Circle as Escape or Backspace depending on context.
+const PS5_BACK_CODES = [27, 8, 461, 10009];
+
+// Runs inside the PS5 system browser, so it keeps the "browser" platform name
+// for feature checks and adds console-specific input, services and fixes.
+export const ps5Adapter = {
+  name: "browser",
+  isPs5: true,
+
+  init() {
+    // Plugins run in the app's QuickJS worker; their network requests go to
+    // the nuvio-ps5 payload (see Ps5PluginService), not the browser's fetch.
+    globalThis.__NUVIO_ALLOW_BROWSER_PLUGIN_RUNTIME__ = true;
+    document.documentElement?.classList?.add("ps5-browser");
+    Ps5Diagnostics.init();
+    Ps5Input.init();
+  },
+
+  exitApp() {
+    // Inside the Nuvio app, EVO serves this page and owns the exit: closing
+    // through it releases the player and GPU before the app parks.
+    if (typeof globalThis.__evoExit === "function") {
+      globalThis.__evoExit();
+      return;
+    }
+    try {
+      globalThis.close?.();
+    } catch (_) {
+      // The system browser may refuse window.close(); the PS button still exits.
+    }
+  },
+
+  isBackEvent(event) {
+    return isBackEvent(event, PS5_BACK_CODES);
+  },
+
+  normalizeKey(event) {
+    return normalizeKeyEvent(event, PS5_BACK_CODES);
+  },
+
+  getDeviceLabel() {
+    return "PlayStation 5";
+  },
+
+  getCapabilities() {
+    return {
+      hlsJs: Boolean(globalThis.Hls?.isSupported?.()),
+      dashJs: Boolean(globalThis.dashjs?.MediaPlayer),
+      nativeVideo: true,
+      webosAvplay: false,
+      tizenAvplay: false
+    };
+  },
+
+  prepareVideoElement(videoElement) {
+    videoElement?.setAttribute?.("playsinline", "");
+  }
+};
diff --git a/js/platform/ps5/ps5Diagnostics.js b/js/platform/ps5/ps5Diagnostics.js
new file mode 100644
index 0000000..0fd9455
--- /dev/null
+++ b/js/platform/ps5/ps5Diagnostics.js
@@ -0,0 +1,187 @@
+import { ps5Log } from "./ps5Service.js";
+
+const VIDEO_TYPES = [
+  'video/mp4; codecs="avc1.640028"',
+  'video/mp4; codecs="avc1.640033"',
+  'video/mp4; codecs="hvc1.1.6.L150.B0"',
+  'video/mp4; codecs="hev1.1.6.L150.B0"',
+  'video/mp4; codecs="hvc1.2.4.L153.B0"',
+  'video/mp4; codecs="av01.0.08M.08"',
+  'video/mp4; codecs="vp09.00.40.08"',
+  'video/webm; codecs="vp9"',
+  'video/webm; codecs="vp8"',
+  "video/x-matroska",
+  "video/mp2t",
+  "application/vnd.apple.mpegurl",
+  "application/x-mpegurl",
+  "application/dash+xml"
+];
+const AUDIO_TYPES = [
+  'audio/mp4; codecs="mp4a.40.2"',
+  'audio/mp4; codecs="ac-3"',
+  'audio/mp4; codecs="ec-3"',
+  'audio/mp4; codecs="dtsc"',
+  'audio/mp4; codecs="opus"',
+  'audio/mp4; codecs="flac"',
+  'audio/webm; codecs="opus"',
+  "audio/mpeg"
+];
+
+function probe(types, test) {
+  const result = {};
+  types.forEach((type) => {
+    try {
+      result[type] = test(type);
+    } catch (error) {
+      result[type] = `error: ${String(error?.message || error)}`;
+    }
+  });
+  return result;
+}
+
+function collectEnvironment() {
+  const video = document.createElement("video");
+  const MediaSourceRef = globalThis.MediaSource || globalThis.WebKitMediaSource;
+  const managedMediaSource = globalThis.ManagedMediaSource;
+  return {
+    userAgent: navigator.userAgent,
+    platform: navigator.platform,
+    language: navigator.language,
+    screen: {
+      width: screen.width,
+      height: screen.height,
+      availWidth: screen.availWidth,
+      availHeight: screen.availHeight
+    },
+    viewport: {
+      innerWidth: innerWidth,
+      innerHeight: innerHeight,
+      clientWidth: document.documentElement.clientWidth,
+      clientHeight: document.documentElement.clientHeight,
+      devicePixelRatio: globalThis.devicePixelRatio
+    },
+    features: {
+      worker: typeof Worker === "function",
+      webAssembly: typeof globalThis.WebAssembly === "object",
+      mediaSource: Boolean(MediaSourceRef),
+      managedMediaSource: Boolean(managedMediaSource),
+      fullscreen: Boolean(
+        document.documentElement.requestFullscreen ||
+        document.documentElement.webkitRequestFullscreen
+      ),
+      fullscreenEnabled: Boolean(document.fullscreenEnabled || document.webkitFullscreenEnabled),
+      gamepads: typeof navigator.getGamepads === "function",
+      pointerEvents: typeof PointerEvent === "function",
+      localStorage: (() => {
+        try {
+          localStorage.setItem("__ps5probe", "1");
+          localStorage.removeItem("__ps5probe");
+          return true;
+        } catch (_) {
+          return false;
+        }
+      })(),
+      indexedDB: typeof indexedDB === "object",
+      serviceWorker: "serviceWorker" in navigator,
+      abortController: typeof AbortController === "function",
+      textDecoder: typeof TextDecoder === "function",
+      cssGrid: CSS?.supports?.("display", "grid") === true,
+      webkitAudioContext: typeof globalThis.webkitAudioContext === "function",
+      audioContext: typeof globalThis.AudioContext === "function"
+    },
+    canPlayType: probe([...VIDEO_TYPES, ...AUDIO_TYPES], (type) => video.canPlayType(type)),
+    mseTypeSupported: MediaSourceRef?.isTypeSupported
+      ? probe([...VIDEO_TYPES, ...AUDIO_TYPES], (type) => MediaSourceRef.isTypeSupported(type))
+      : null
+  };
+}
+
+// Whether the browser path could ever be HDR / 4K on this console.
+async function probeHdrAnd4k() {
+  const result = {
+    dynamicRangeHigh: globalThis.matchMedia?.("(dynamic-range: high)")?.matches ?? null,
+    videoDynamicRangeHigh: globalThis.matchMedia?.("(video-dynamic-range: high)")?.matches ?? null,
+    colorGamutRec2020: globalThis.matchMedia?.("(color-gamut: rec2020)")?.matches ?? null,
+    colorDepth: globalThis.screen?.colorDepth ?? null,
+    decodingInfo: {}
+  };
+  const capabilities = globalThis.navigator?.mediaCapabilities;
+  if (typeof capabilities?.decodingInfo !== "function") return result;
+  const configs = {
+    hevc4kPq: {
+      contentType: 'video/mp4; codecs="hvc1.2.4.L153.B0"',
+      width: 3840, height: 2160, bitrate: 25000000, framerate: 24,
+      transferFunction: "pq", colorGamut: "rec2020", hdrMetadataType: "smpteSt2086"
+    },
+    hevc4kSdr: {
+      contentType: 'video/mp4; codecs="hvc1.1.6.L153.B0"',
+      width: 3840, height: 2160, bitrate: 25000000, framerate: 24
+    },
+    avc1080: {
+      contentType: 'video/mp4; codecs="avc1.640028"',
+      width: 1920, height: 1080, bitrate: 8000000, framerate: 24
+    }
+  };
+  for (const [name, video] of Object.entries(configs)) {
+    try {
+      const info = await capabilities.decodingInfo({ type: "media-source", video });
+      result.decodingInfo[name] = {
+        supported: info.supported,
+        smooth: info.smooth,
+        powerEfficient: info.powerEfficient
+      };
+    } catch (error) {
+      result.decodingInfo[name] = `error: ${String(error?.message || error)}`;
+    }
+  }
+  return result;
+}
+
+function hookErrors() {
+  window.addEventListener("error", (event) => {
+    ps5Log("error", "window error", {
+      message: String(event?.message || ""),
+      source: String(event?.filename || ""),
+      line: event?.lineno,
+      column: event?.colno,
+      stack: String(event?.error?.stack || "").slice(0, 1600)
+    });
+  });
+  window.addEventListener("unhandledrejection", (event) => {
+    const reason = event?.reason;
+    ps5Log("error", "unhandled rejection", {
+      message: String(reason?.message || reason || ""),
+      stack: String(reason?.stack || "").slice(0, 1600)
+    });
+  });
+}
+
+export const Ps5Diagnostics = {
+  init() {
+    hookErrors();
+    const report = () => {
+      try {
+        ps5Log("info", "environment", collectEnvironment());
+      } catch (error) {
+        ps5Log("error", "environment probe failed", { message: String(error?.message || error) });
+      }
+    };
+    report();
+    probeHdrAnd4k()
+      .then((result) => ps5Log("info", "hdr and 4k probe", result))
+      .catch((error) => ps5Log("warn", "hdr probe failed", { message: String(error?.message || error) }));
+    // Viewport size changes when the browser window goes fullscreen.
+    let resizeTimer = null;
+    window.addEventListener("resize", () => {
+      clearTimeout(resizeTimer);
+      resizeTimer = setTimeout(() => {
+        ps5Log("info", "viewport", {
+          innerWidth,
+          innerHeight,
+          devicePixelRatio: globalThis.devicePixelRatio,
+          fullscreen: Boolean(document.fullscreenElement || document.webkitFullscreenElement)
+        });
+      }, 400);
+    });
+  }
+};
diff --git a/js/platform/ps5/ps5Input.js b/js/platform/ps5/ps5Input.js
new file mode 100644
index 0000000..716d0c4
--- /dev/null
+++ b/js/platform/ps5/ps5Input.js
@@ -0,0 +1,195 @@
+import { ps5Log } from "./ps5Service.js";
+
+// PS5 system browser input, as measured on FW 13.60:
+//  - D-pad arrives as arrow keys (keyCode 37-40, sometimes 156 with key
+//    "ArrowRight"), Circle as Escape (27).
+//  - Cross is a mouse click at the on-screen cursor (left stick), not a key.
+//  - The system keyboard sends every character as keyCode 229 ("Process").
+//  - There is no Gamepad or Fullscreen API.
+// Nuvio runs in pointer-remote mode (hover focuses, click activates). This
+// module keeps the cursor and the D-pad from fighting over focus: a D-pad
+// press switches to D-pad mode, where the cursor is ignored (no hover focus)
+// and Cross acts on the item the D-pad selected, wherever the cursor rests.
+// Moving the cursor a real distance hands control back to it (issue #2).
+
+const ARROW_CODES = new Set([37, 38, 39, 40, 156]);
+// A real cursor move shifts the pointer; WebKit also fires mousemove when the
+// page scrolls under a still cursor, which must not steal D-pad focus.
+const MIN_POINTER_TRAVEL_PX = 3;
+// In D-pad mode the cursor must travel this far from where it rested before
+// it takes over again, so a drifting stick or a nudge does not.
+const POINTER_WAKE_PX = 40;
+const DPAD_MODE_CLASS = "ps5-dpad-mode";
+const HOVER_EVENTS = [
+  "mouseover",
+  "mouseout",
+  "mouseenter",
+  "mouseleave",
+  "pointerover",
+  "pointerout",
+  "pointerenter",
+  "pointerleave"
+];
+const PRESS_EVENTS = ["mousedown", "mouseup", "pointerdown", "pointerup"];
+const MAX_LOGGED_KEYS = 60;
+
+const state = {
+  initialized: false,
+  dpadMode: false,
+  anchorX: null,
+  anchorY: null,
+  lastPointerX: null,
+  lastPointerY: null,
+  redirectClick: false,
+  loggedKeys: 0
+};
+
+function isEditable(target) {
+  const tag = String(target?.tagName || "").toUpperCase();
+  return Boolean(target?.isContentEditable || tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT");
+}
+
+function focusedNode() {
+  const active = document.activeElement;
+  if (active && active !== document.body && active.classList?.contains("focusable")) {
+    return active;
+  }
+  return document.querySelector(".focusable.focused") || null;
+}
+
+function pointerPosition(event) {
+  return {
+    x: Number(event.screenX ?? event.clientX),
+    y: Number(event.screenY ?? event.clientY)
+  };
+}
+
+function setDpadMode(enabled) {
+  state.dpadMode = enabled;
+  state.redirectClick = false;
+  if (enabled) {
+    state.anchorX = state.lastPointerX;
+    state.anchorY = state.lastPointerY;
+  }
+  document.documentElement?.classList?.toggle(DPAD_MODE_CLASS, enabled);
+}
+
+function swallow(event) {
+  event.preventDefault();
+  event.stopImmediatePropagation();
+}
+
+function dispatchEnter(target) {
+  ["keydown", "keyup"].forEach((type) => {
+    const event = new KeyboardEvent(type, {
+      key: "Enter",
+      code: "Enter",
+      bubbles: true,
+      cancelable: true
+    });
+    Object.defineProperty(event, "keyCode", { value: 13 });
+    Object.defineProperty(event, "which", { value: 13 });
+    (target || document.body).dispatchEvent(event);
+  });
+}
+
+// True when Cross, pressed in D-pad mode on `target`, should activate the
+// D-pad selection instead of what lies under the cursor.
+function shouldRedirect(target) {
+  if (!state.dpadMode || isEditable(target)) return false;
+  const focused = focusedNode();
+  return Boolean(focused && !focused.contains(target));
+}
+
+function onKey(event) {
+  if (!event.isTrusted) return;
+  const keyCode = Number(event.keyCode || event.which || 0);
+
+  // System keyboard input belongs to the text field, not to navigation.
+  if (keyCode === 229 && isEditable(event.target)) {
+    event.stopImmediatePropagation();
+    return;
+  }
+
+  if (event.type !== "keydown") return;
+  if (ARROW_CODES.has(keyCode) || String(event.key || "").startsWith("Arrow")) {
+    setDpadMode(true);
+  }
+  if (state.loggedKeys < MAX_LOGGED_KEYS) {
+    state.loggedKeys += 1;
+    ps5Log("info", "key", { key: event.key, code: event.code, keyCode });
+  }
+}
+
+function onPointerMove(event) {
+  if (!event.isTrusted) return;
+  const { x, y } = pointerPosition(event);
+  const moved =
+    state.lastPointerX === null ||
+    Math.abs(x - state.lastPointerX) >= MIN_POINTER_TRAVEL_PX ||
+    Math.abs(y - state.lastPointerY) >= MIN_POINTER_TRAVEL_PX;
+  if (moved) {
+    state.lastPointerX = x;
+    state.lastPointerY = y;
+  }
+  if (state.dpadMode) {
+    if (state.anchorX === null) {
+      state.anchorX = x;
+      state.anchorY = y;
+    }
+    if (Math.hypot(x - state.anchorX, y - state.anchorY) < POINTER_WAKE_PX) {
+      event.stopImmediatePropagation();
+      return;
+    }
+    setDpadMode(false);
+    return;
+  }
+  if (!moved) {
+    // Scroll-induced synthetic move: hide it from the focus engine.
+    event.stopImmediatePropagation();
+  }
+}
+
+function onHover(event) {
+  if (event.isTrusted && state.dpadMode) {
+    event.stopImmediatePropagation();
+  }
+}
+
+function onPress(event) {
+  if (!event.isTrusted) return;
+  if (!state.dpadMode) return;
+  if (event.type === "mousedown" || event.type === "pointerdown") {
+    state.redirectClick = shouldRedirect(event.target);
+    if (!state.redirectClick && isEditable(event.target)) {
+      setDpadMode(false);
+    }
+  }
+  // The press must not move focus to the item under the cursor.
+  if (state.redirectClick) swallow(event);
+}
+
+function onClick(event) {
+  if (!event.isTrusted) return;
+  const redirect = state.redirectClick || shouldRedirect(event.target);
+  state.redirectClick = false;
+  if (!redirect) return;
+  swallow(event);
+  dispatchEnter(focusedNode());
+}
+
+export const Ps5Input = {
+  init() {
+    if (state.initialized) return;
+    state.initialized = true;
+    // Registered before FocusEngine.init(), so these capture listeners run first.
+    document.addEventListener("keydown", onKey, true);
+    document.addEventListener("keyup", onKey, true);
+    document.addEventListener("keypress", onKey, true);
+    document.addEventListener("mousemove", onPointerMove, true);
+    document.addEventListener("pointermove", onPointerMove, true);
+    HOVER_EVENTS.forEach((type) => document.addEventListener(type, onHover, true));
+    PRESS_EVENTS.forEach((type) => document.addEventListener(type, onPress, true));
+    document.addEventListener("click", onClick, true);
+  }
+};
diff --git a/js/platform/ps5/ps5NativePlayer.js b/js/platform/ps5/ps5NativePlayer.js
new file mode 100644
index 0000000..bdd96ee
--- /dev/null
+++ b/js/platform/ps5/ps5NativePlayer.js
@@ -0,0 +1,77 @@
+import { Platform } from "../index.js";
+import { ps5Log, ps5ServiceRequest } from "./ps5Service.js";
+
+// The Nuvio Player: the PS5 app's built-in native player (hardware HEVC/H.264
+// up to 4K, HDR10/HLG output, Matroska, TrueHD/DTS-HD/E-AC-3 as multichannel
+// PCM, libass subtitles), with Nuvio's player interface drawn natively over
+// the picture. The browser cannot show native video under this page, so a
+// stream is handed to the app through the nuvio-ps5 payload: the app closes
+// this page, plays it, and opens Nuvio again afterwards, where
+// takeReturn() picks the session up (progress, next episode, back to the
+// screen the viewer came from).
+export const Ps5NativePlayer = {
+  available: null,
+
+  // True when the Nuvio app is polling for streams, i.e. this page is running
+  // inside it rather than in the plain PS5 browser. Asked once per page.
+  async isAvailable() {
+    if (!Platform.isPS5()) return false;
+    if (this.available !== null) return this.available;
+    try {
+      const status = await ps5ServiceRequest("/api/player/status", { timeoutMs: 3000 });
+      this.available = Boolean(status?.nativePlayer);
+    } catch (_) {
+      this.available = false;
+    }
+    return this.available;
+  },
+
+  // Hands a playback request (see the player screen's buildPs5NativeRequest)
+  // to the app. Resolves once the payload has queued it.
+  async play(request) {
+    const result = await ps5ServiceRequest("/api/player/play", {
+      method: "POST",
+      body: request,
+      timeoutMs: 8000
+    });
+    ps5Log("info", "native player: queued", {
+      id: result?.id,
+      startPosition: request?.startPosition,
+      sources: Array.isArray(request?.sources) ? request.sources.length : 0,
+      subtitleRequests: Array.isArray(request?.subtitleRequests) ? request.subtitleRequests.length : 0
+    });
+    return result;
+  },
+
+  // After Nuvio reopens: the finished playback with the context the page
+  // sent along (route stack, player params, profile), or null.
+  async takeReturn() {
+    if (!Platform.isPS5()) return null;
+    try {
+      const result = await ps5ServiceRequest("/api/player/result", { timeoutMs: 3000 });
+      if (!result || typeof result !== "object" || !result.state) return null;
+      const context = result.context && typeof result.context === "object" ? result.context : null;
+      ps5Log("info", "native player: returned", {
+        state: result.state,
+        position: result.position,
+        duration: result.duration,
+        action: result.action?.type || null,
+        hasContext: Boolean(context?.playerParams)
+      });
+      if (!context?.playerParams) return null;
+      const { context: _context, ...rest } = result;
+      return { result: rest, context };
+    } catch (_) {
+      return null;
+    }
+  }
+};
+
+// A JSON copy (plain data only), or null when the value cannot be copied.
+export function plainCopy(value) {
+  try {
+    return JSON.parse(JSON.stringify(value));
+  } catch (_) {
+    return null;
+  }
+}
diff --git a/js/platform/ps5/ps5PluginService.js b/js/platform/ps5/ps5PluginService.js
new file mode 100644
index 0000000..3540cd6
--- /dev/null
+++ b/js/platform/ps5/ps5PluginService.js
@@ -0,0 +1,48 @@
+import { ps5ServiceRequest } from "./ps5Service.js";
+
+const PROBE_TIMEOUT_MS = 2500;
+
+// Same routes and payloads as services/plugin-http.cjs, served natively by the
+// nuvio-ps5 payload under /plugin/ so provider requests escape browser CORS.
+export const Ps5PluginService = {
+  isAvailable() {
+    return true;
+  },
+
+  async health() {
+    return ps5ServiceRequest("/plugin/health", { timeoutMs: PROBE_TIMEOUT_MS });
+  },
+
+  capabilities() {
+    return ps5ServiceRequest("/plugin/capabilities", { timeoutMs: PROBE_TIMEOUT_MS });
+  },
+
+  diagnostics() {
+    return ps5ServiceRequest("/plugin/diagnostics", { timeoutMs: PROBE_TIMEOUT_MS });
+  },
+
+  fetch(payload, { timeoutMs = 30000, signal } = {}) {
+    return ps5ServiceRequest("/plugin/fetch", {
+      method: "POST",
+      body: payload,
+      timeoutMs,
+      signal
+    });
+  },
+
+  cancel(payload) {
+    return ps5ServiceRequest("/plugin/cancel", {
+      method: "POST",
+      body: payload,
+      timeoutMs: 2000
+    }).catch(() => false);
+  },
+
+  clearCache() {
+    return ps5ServiceRequest("/plugin/cache/clear", {
+      method: "POST",
+      body: {},
+      timeoutMs: 5000
+    });
+  }
+};
diff --git a/js/platform/ps5/ps5Remux.js b/js/platform/ps5/ps5Remux.js
new file mode 100644
index 0000000..bdc65dc
--- /dev/null
+++ b/js/platform/ps5/ps5Remux.js
@@ -0,0 +1,54 @@
+import { Platform } from "../index.js";
+import { ps5Log, ps5ServiceRequest } from "./ps5Service.js";
+import { getPs5ServiceBaseUrl } from "./ps5Service.js";
+
+// The PS5 browser plays H.264/HEVC with AAC/AC-3/E-AC-3 through MSE but not
+// Matroska, DTS, TrueHD, FLAC or Opus. The nuvio-ps5 payload repackages a
+// direct file as HLS (fMP4 segments cut on keyframes) that hls.js can play.
+export const Ps5Remux = {
+  // Inside the EVO-hosted Nuvio app, EVO's hook takes the original stream URL
+  // to its hardware player, so the browser path must not be repackaged.
+  isNativePlayerHost() {
+    return Boolean(globalThis.__evoHook);
+  },
+
+  shouldRemux(sourceType, { isHls = false, isDash = false } = {}) {
+    if (!Platform.isPS5() || this.isNativePlayerHost()) return false;
+    if (isHls || isDash) return false;
+    return !/^application\/(vnd\.apple\.mpegurl|x-mpegurl|dash\+xml)/i.test(String(sourceType || ""));
+  },
+
+  async open(url, requestHeaders = {}) {
+    try {
+      const result = await ps5ServiceRequest("/api/stream/open", {
+        method: "POST",
+        body: { url, headers: requestHeaders || {} },
+        timeoutMs: 45000
+      });
+      ps5Log("info", "remux session", {
+        id: result.id,
+        duration: result.duration,
+        segments: result.segments,
+        video: result.video,
+        audio: result.audio,
+        audioConverted: result.audioConverted
+      });
+      return {
+        id: result.id,
+        playlistUrl: `${getPs5ServiceBaseUrl()}${result.playlist}`,
+        duration: Number(result.duration || 0)
+      };
+    } catch (error) {
+      const message = String(error?.message || error);
+      ps5Log("warn", "remux unavailable", { message });
+      return { error: message };
+    }
+  },
+
+  close(id) {
+    if (!id) return;
+    ps5ServiceRequest("/api/stream/close", { method: "POST", body: { id }, timeoutMs: 3000 }).catch(
+      () => {}
+    );
+  }
+};
diff --git a/js/platform/ps5/ps5Service.js b/js/platform/ps5/ps5Service.js
new file mode 100644
index 0000000..79dc703
--- /dev/null
+++ b/js/platform/ps5/ps5Service.js
@@ -0,0 +1,70 @@
+// The nuvio-ps5 payload serves this app and its native PS5 services from one
+// loopback origin, so every request below is same-origin and needs no CORS.
+export const PS5_SERVICE_PORT = 17600;
+
+export function isPs5UserAgent() {
+  const userAgent = String(globalThis.navigator?.userAgent || "");
+  const search = String(globalThis.location?.search || "").toLowerCase();
+  return /PlayStation 5/i.test(userAgent) || search.includes("platform=ps5");
+}
+
+export function getPs5ServiceBaseUrl() {
+  const location = globalThis.location;
+  if (
+    location &&
+    /^https?:$/.test(location.protocol) &&
+    Number(location.port) === PS5_SERVICE_PORT
+  ) {
+    return location.origin;
+  }
+  return `http://127.0.0.1:${PS5_SERVICE_PORT}`;
+}
+
+export async function ps5ServiceRequest(
+  path,
+  { method = "GET", body, timeoutMs = 30000, signal } = {}
+) {
+  const controller = typeof AbortController === "function" ? new AbortController() : null;
+  const abort = () => controller?.abort();
+  signal?.addEventListener?.("abort", abort, { once: true });
+  const timer = setTimeout(abort, timeoutMs);
+  try {
+    const response = await fetch(`${getPs5ServiceBaseUrl()}${path}`, {
+      method,
+      headers: body === undefined ? undefined : { "Content-Type": "application/json" },
+      body: body === undefined ? undefined : JSON.stringify(body),
+      cache: "no-store",
+      signal: controller?.signal
+    });
+    const result = await response.json().catch(() => ({}));
+    if (!response.ok || result.returnValue === false) {
+      throw new Error(result.errorText || `PS5 service HTTP ${response.status}`);
+    }
+    return result;
+  } finally {
+    clearTimeout(timer);
+    signal?.removeEventListener?.("abort", abort);
+  }
+}
+
+// Fire-and-forget line for /data/nuvio/nuvio.log on the console. Used for
+// on-device diagnostics, so it must never throw or block the UI.
+export function ps5Log(level, message, details) {
+  try {
+    const line = JSON.stringify({
+      t: Date.now(),
+      level: String(level || "info"),
+      message: String(message || ""),
+      details: details === undefined ? undefined : details
+    });
+    fetch(`${getPs5ServiceBaseUrl()}/api/log`, {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: line,
+      cache: "no-store",
+      keepalive: true
+    }).catch(() => {});
+  } catch (_) {
+    // Logging is best effort.
+  }
+}
diff --git a/ps5-boot.js b/ps5-boot.js
new file mode 100644
index 0000000..2348024
--- /dev/null
+++ b/ps5-boot.js
@@ -0,0 +1,295 @@
+/*
+ * PS5 boot reporter. Loads before everything else and only activates in the
+ * PS5 browser: it streams boot stages, errors, console warnings and a periodic
+ * heartbeat to the nuvio-ps5 payload (/api/log -> /data/nuvio/nuvio.log), so
+ * startup problems on the console can be diagnosed from a PC.
+ * Plain ES5 on purpose: it must run even if the main bundle cannot.
+ */
+(function installPs5BootReporter(window, document) {
+  "use strict";
+
+  var userAgent = String((window.navigator && window.navigator.userAgent) || "");
+  var search = String((window.location && window.location.search) || "").toLowerCase();
+  if (!/PlayStation 5/i.test(userAgent) && search.indexOf("platform=ps5") === -1) {
+    return;
+  }
+
+  var startedAt = Date.now();
+  var sent = 0;
+  var MAX_LINES = 400;
+  var lastStage = "";
+
+  function post(level, message, details) {
+    if (sent >= MAX_LINES) return;
+    sent += 1;
+    try {
+      var xhr = new XMLHttpRequest();
+      xhr.open("POST", "/api/log", true);
+      xhr.setRequestHeader("Content-Type", "application/json");
+      xhr.send(
+        JSON.stringify({
+          t: Date.now(),
+          ms: Date.now() - startedAt,
+          level: level,
+          message: String(message),
+          details: details
+        })
+      );
+    } catch (_) {
+      // Best effort only.
+    }
+  }
+
+  window.__NUVIO_PS5_BOOT_LOG__ = post;
+
+  /*
+   * Settings persistence. The PS5 browser dialog (the full-screen launcher)
+   * opens with empty storage every time, so Nuvio's localStorage (sign-in,
+   * addons, profiles, settings) is mirrored to the payload and restored here,
+   * before any app code reads it. Values over 512 KB are caches and skipped.
+   */
+  var STORE_URL = "/api/storage";
+  var STAMP_KEY = "__nuvioPs5StoreStamp";
+  var MAX_VALUE_CHARS = 512 * 1024;
+  var lastSaved = "";
+
+  function readItems() {
+    var items = {};
+    for (var i = 0; i < localStorage.length; i += 1) {
+      var key = localStorage.key(i);
+      if (key === STAMP_KEY) continue;
+      var value = localStorage.getItem(key);
+      if (value !== null && value.length <= MAX_VALUE_CHARS) items[key] = value;
+    }
+    return items;
+  }
+
+  function restoreStorage() {
+    try {
+      var xhr = new XMLHttpRequest();
+      xhr.open("GET", STORE_URL, false);
+      xhr.send(null);
+      if (xhr.status !== 200) return;
+      var saved = JSON.parse(xhr.responseText || "{}");
+      var localStamp = Number(localStorage.getItem(STAMP_KEY) || 0);
+      var savedStamp = Number(saved.stamp || 0);
+      if (!saved.items || savedStamp <= localStamp) {
+        lastSaved = JSON.stringify(readItems());
+        return;
+      }
+      localStorage.clear();
+      var count = 0;
+      for (var key in saved.items) {
+        if (Object.prototype.hasOwnProperty.call(saved.items, key)) {
+          localStorage.setItem(key, String(saved.items[key]));
+          count += 1;
+        }
+      }
+      localStorage.setItem(STAMP_KEY, String(savedStamp));
+      lastSaved = JSON.stringify(readItems());
+      post("info", "storage restored", { keys: count, stamp: savedStamp });
+    } catch (error) {
+      post("warn", "storage restore failed", { message: String((error && error.message) || error) });
+    }
+  }
+
+  function saveStorage(synchronous) {
+    try {
+      var serialized = JSON.stringify(readItems());
+      if (serialized === lastSaved) return;
+      var stamp = Date.now();
+      localStorage.setItem(STAMP_KEY, String(stamp));
+      var xhr = new XMLHttpRequest();
+      xhr.open("POST", STORE_URL, !synchronous);
+      xhr.setRequestHeader("Content-Type", "application/json");
+      xhr.send('{"stamp":' + stamp + ',"items":' + serialized + "}");
+      lastSaved = serialized;
+    } catch (_) {
+      // Retried on the next interval.
+    }
+  }
+
+  // Inside the Nuvio app the page comes through EVO's loopback proxy (another
+  // port); the relative URL still reaches the payload, so both share one store.
+  if (String(window.location.port) === "17600" || window.__evoHook) {
+    restoreStorage();
+    window.setInterval(function periodicSave() {
+      saveStorage(false);
+    }, 4000);
+    window.addEventListener("pagehide", function saveOnHide() {
+      saveStorage(true);
+    });
+    document.addEventListener("visibilitychange", function saveWhenHidden() {
+      if (document.visibilityState === "hidden") saveStorage(true);
+    });
+  }
+  /*
+   * Console clock correction. A jailbroken PS5 kept off PSN often has a wrong
+   * clock, and Nuvio compares server expiry times with Date.now(): a console a
+   * few minutes ahead saw every sign-in QR code as already expired (issue #1).
+   * The payload measures the real time (/api/time); Date.now() is shifted by
+   * that offset before the app runs. Asked once synchronously (the payload
+   * answers from memory), then again until the payload has a measurement.
+   */
+  (function correctClock() {
+    var applied = false;
+    var tries = 0;
+    var realNow = Date.now;
+    function apply(text) {
+      var info;
+      try {
+        info = JSON.parse(text);
+      } catch (_) {
+        return false;
+      }
+      if (!info || info.known !== true) return false;
+      var offset = Number(info.offsetMs);
+      if (!isFinite(offset)) return true;
+      window.__NUVIO_PS5_CLOCK_OFFSET_MS__ = offset;
+      if (Math.abs(offset) >= 30000 && !applied) {
+        applied = true;
+        Date.now = function nowCorrected() {
+          return realNow.call(Date) + offset;
+        };
+        post("warn", "clock corrected", { offsetSeconds: Math.round(offset / 1000), source: info.source });
+      }
+      return true;
+    }
+    function ask(sync) {
+      try {
+        var xhr = new XMLHttpRequest();
+        xhr.open("GET", "/api/time", !sync);
+        if (!sync) {
+          xhr.onload = function onTime() {
+            if (!apply(xhr.responseText) && ++tries < 30) window.setTimeout(function again() { ask(false); }, 3000);
+          };
+        }
+        xhr.send(null);
+        if (sync) return apply(xhr.responseText);
+      } catch (_) {
+        return true;
+      }
+      return true;
+    }
+    if (!ask(true)) window.setTimeout(function later() { ask(false); }, 3000);
+  })();
+
+  post("info", "boot reporter start", {
+    href: String(window.location && window.location.href),
+    userAgent: userAgent,
+    innerWidth: window.innerWidth,
+    innerHeight: window.innerHeight,
+    devicePixelRatio: window.devicePixelRatio
+  });
+
+  window.addEventListener(
+    "error",
+    function onError(event) {
+      var target = event && event.target;
+      if (target && target !== window && (target.src || target.href)) {
+        post("error", "resource failed", { url: String(target.src || target.href) });
+        return;
+      }
+      post("error", "script error", {
+        message: String((event && event.message) || ""),
+        source: String((event && event.filename) || ""),
+        line: event && event.lineno,
+        column: event && event.colno,
+        stack: String((event && event.error && event.error.stack) || "").slice(0, 2000)
+      });
+    },
+    true
+  );
+
+  window.addEventListener("unhandledrejection", function onRejection(event) {
+    var reason = event && event.reason;
+    post("error", "unhandled rejection", {
+      message: String((reason && reason.message) || reason || ""),
+      stack: String((reason && reason.stack) || "").slice(0, 2000)
+    });
+  });
+
+  ["error", "warn"].forEach(function wrapConsole(level) {
+    var original = window.console && window.console[level];
+    if (typeof original !== "function") return;
+    window.console[level] = function forwardConsole() {
+      var parts = [];
+      for (var i = 0; i < arguments.length; i += 1) {
+        var value = arguments[i];
+        try {
+          // Errors (and DOMExceptions such as AbortError, which have no
+          // stack and stringify to {}) are logged by name and message.
+          var described =
+            value && typeof value === "object" && (value.message || value.name)
+              ? String(value.name || "Error") + ": " + String(value.message || "") +
+                (value.status ? " (HTTP " + value.status + ")" : "") +
+                (value.stack ? " " + String(value.stack).split("\n")[0] : "")
+              : null;
+          parts.push(
+            described !== null
+              ? described
+              : typeof value === "object"
+                ? JSON.stringify(value)
+                : String(value)
+          );
+        } catch (_) {
+          parts.push(String(value));
+        }
+      }
+      post(level, "console." + level, { text: parts.join(" ").slice(0, 2000) });
+      return original.apply(this, arguments);
+    };
+  });
+
+  // Wrap the boot guard's stage() once boot-guard.js has installed it.
+  var stageHookTimer = window.setInterval(function hookBootGuard() {
+    var guard = window.NuvioBootGuard;
+    if (!guard || guard.__ps5Hooked) return;
+    guard.__ps5Hooked = true;
+    window.clearInterval(stageHookTimer);
+    var originalStage = guard.stage;
+    guard.stage = function reportStage(name) {
+      if (name && name !== lastStage) {
+        lastStage = String(name);
+        post("info", "boot stage", { stage: lastStage });
+      }
+      return originalStage.apply(guard, arguments);
+    };
+    var originalReady = guard.ready;
+    guard.ready = function reportReady() {
+      post("info", "boot ready", {});
+      return originalReady.apply(guard, arguments);
+    };
+    var originalFail = guard.fail;
+    guard.fail = function reportFail(message, details, code) {
+      post("error", "boot failed", {
+        message: String(message),
+        details: String(details || "").slice(0, 2000),
+        code: code
+      });
+      return originalFail.apply(guard, arguments);
+    };
+  }, 5);
+
+  var beats = 0;
+  var heartbeat = window.setInterval(function reportHeartbeat() {
+    beats += 1;
+    var guard = window.NuvioBootGuard;
+    var active = document.activeElement;
+    post("info", "heartbeat", {
+      readyState: document.readyState,
+      bootActive: Boolean(guard && guard.isActive && guard.isActive()),
+      lastStage: lastStage,
+      hash: String(window.location.hash || ""),
+      bodyClass: String((document.body && document.body.className) || "").slice(0, 200),
+      nodes: document.getElementsByTagName("*").length,
+      active: active
+        ? String(active.tagName) + "#" + String(active.id || "") + "." + String(active.className || "").slice(0, 80)
+        : "",
+      fullscreen: Boolean(document.fullscreenElement || document.webkitFullscreenElement),
+      innerWidth: window.innerWidth,
+      innerHeight: window.innerHeight
+    });
+    if (beats >= 30) window.clearInterval(heartbeat);
+  }, 10000);
+})(window, document);
diff --git a/ps5-keytest.html b/ps5-keytest.html
new file mode 100644
index 0000000..8297cd3
--- /dev/null
+++ b/ps5-keytest.html
@@ -0,0 +1,114 @@
+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="UTF-8" />
+    <title>Nuvio PS5 controller test</title>
+    <style>
+      :root { color-scheme: dark; }
+      html, body { margin: 0; height: 100%; background: #0d0e12; color: #f2f2f5; font: 28px/1.35 system-ui, sans-serif; }
+      main { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; gap: 24px; text-align: center; }
+      #step { font-size: 22px; color: #9aa0ad; }
+      #prompt { font-size: 48px; font-weight: 700; }
+      #seen { font-size: 22px; color: #7dd3fc; min-height: 1.4em; }
+      #done { display: none; font-size: 30px; color: #86efac; }
+      .hint { font-size: 18px; color: #6b7280; max-width: 70%; }
+    </style>
+  </head>
+  <body>
+    <main>
+      <div id="step"></div>
+      <div id="prompt">Loading…</div>
+      <div id="seen"></div>
+      <div id="done">All done. Thank you! You can close this page (PS button).</div>
+      <div class="hint">Press only the button shown. Each step moves on after the press, or after 7 seconds if nothing arrives. Do not press Triangle, OPTIONS, L3 or R3: the browser uses them itself.</div>
+    </main>
+    <script>
+      (function () {
+        var steps = [
+          "Cross (X)", "Circle (O)", "Square", "L1", "R1", "L2", "R2",
+          "D-pad UP", "D-pad DOWN", "D-pad LEFT", "D-pad RIGHT",
+          "Left stick: push RIGHT then let go", "Right stick: push DOWN then let go",
+          "Touchpad: press it", "CREATE button (left of touchpad)"
+        ];
+        var index = -1;
+        var timer = null;
+        var events = [];
+        var startedAt = Date.now();
+
+        function log(message, details) {
+          try {
+            var xhr = new XMLHttpRequest();
+            xhr.open("POST", "/api/log", true);
+            xhr.setRequestHeader("Content-Type", "application/json");
+            xhr.send(JSON.stringify({ t: Date.now(), level: "info", message: message, details: details }));
+          } catch (_) {}
+        }
+
+        function describe(event) {
+          var d = { type: event.type, ms: Date.now() - startedAt };
+          if (event.type.indexOf("key") === 0) {
+            d.key = event.key; d.code = event.code; d.keyCode = event.keyCode; d.which = event.which;
+            d.location = event.location; d.repeat = event.repeat;
+          } else if (event.type === "wheel") {
+            d.deltaX = event.deltaX; d.deltaY = event.deltaY; d.deltaMode = event.deltaMode;
+          } else if (event.type === "scroll") {
+            d.scrollX = window.scrollX; d.scrollY = window.scrollY;
+          } else {
+            d.x = event.clientX; d.y = event.clientY; d.button = event.button; d.buttons = event.buttons;
+            d.pointerType = event.pointerType;
+            d.target = event.target && event.target.id;
+          }
+          return d;
+        }
+
+        function next() {
+          clearTimeout(timer);
+          if (index >= 0) {
+            log("keytest step", { step: steps[index], events: events });
+          }
+          events = [];
+          index += 1;
+          if (index >= steps.length) {
+            document.getElementById("prompt").textContent = "";
+            document.getElementById("step").textContent = "";
+            document.getElementById("done").style.display = "block";
+            log("keytest finished", { userAgent: navigator.userAgent });
+            return;
+          }
+          document.getElementById("step").textContent = "Step " + (index + 1) + " of " + steps.length;
+          document.getElementById("prompt").textContent = "Press " + steps[index];
+          document.getElementById("seen").textContent = "";
+          timer = setTimeout(next, 7000);
+        }
+
+        var moveCount = 0;
+        function record(event) {
+          if (index < 0 || index >= steps.length) return;
+          if (event.type === "pointermove" || event.type === "mousemove") {
+            moveCount += 1;
+            if (moveCount % 10 !== 1) return;
+          }
+          events.push(describe(event));
+          document.getElementById("seen").textContent =
+            event.type + (event.key ? " " + event.key + " (" + event.keyCode + ")" : "");
+          if (event.type === "keyup" || event.type === "click" || event.type === "wheel" || event.type === "scroll") {
+            clearTimeout(timer);
+            timer = setTimeout(next, 900);
+          }
+          if (event.type === "keydown" || event.type === "keyup") {
+            event.preventDefault();
+          }
+        }
+
+        ["keydown", "keyup", "keypress", "mousedown", "mouseup", "click", "pointerdown", "pointerup",
+         "pointermove", "mousemove", "wheel", "contextmenu", "auxclick", "dblclick"].forEach(function (type) {
+          document.addEventListener(type, record, true);
+        });
+        window.addEventListener("scroll", record, true);
+        document.body.style.height = "300%";
+        log("keytest start", { innerWidth: innerWidth, innerHeight: innerHeight });
+        setTimeout(next, 800);
+      })();
+    </script>
+  </body>
+</html>
